# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# The account used to SEND the email
SENDER_EMAIL=you@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_app_password

# The recipient (pre-filled)
RECIPIENT_EMAIL=judy.weldon@Baincapital.com

# ── Google Maps ────────────────────────────────────────────────────────────────
# Required for commute-time filtering.
# Enable "Distance Matrix API" in Google Cloud Console, then create an API key.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
